<Window x:Class="OnlineCaffe.HistoryOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineCaffe"
        mc:Ignorable="d"
        Title="HistoryOrder" Height="450" Width="600">
    <Grid>
        <Label Content="Выберите статус заказа:" HorizontalAlignment="Left" Margin="40,33,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <ComboBox x:Name="status" HorizontalAlignment="Left" Margin="40,69,0,0" VerticalAlignment="Top" Width="184" FontSize="16" SelectionChanged="ComboBox_SelectionChanged" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <ListBox x:Name="Orders" Margin="10,114,60,120" FontFamily="Tw Cen MT Condensed Extra Bold">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Заказ №{0} от {1:dd.MM.yyyy} на сумму {2:F2} ₽">
                                <Binding Path="id_order"/>
                                <Binding Path="Registration_Date"/>
                                <Binding Path="Cost"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Вернуться на главную" HorizontalAlignment="Left" Margin="10,377,0,0" VerticalAlignment="Top" FontSize="16" Height="35" Width="191" Click="Button_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Изменить статус заказа" HorizontalAlignment="Left" Margin="331,377,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold" Height="35" Click="Button_Click_1"/>
        <Label Content="Выберите статус для изменения:" HorizontalAlignment="Left" Margin="216,332,0,0" VerticalAlignment="Top" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <ComboBox x:Name="statuss" HorizontalAlignment="Left" Margin="466,332,0,0" VerticalAlignment="Top" Width="120" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold" SelectionChanged="statuss_SelectionChanged"/>

    </Grid>
</Window>
