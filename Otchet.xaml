<Window x:Class="OnlineCaffe.Otchet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Платежи" FontFamily="Tw Cen MT Condensed Extra Bold">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="cmbFilterStatus" Width="120" Margin="5">

                        </ComboBox>

                        <TextBlock Text="Способ:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                        <ComboBox x:Name="cmbFilterMethod" Width="140" Margin="5">

                        </ComboBox>

                        <Button x:Name="btnRefresh" Content="Обновить" Width="80" Margin="15,5,5,5" Click="BtnRefresh_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgPayments" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ заказа" Binding="{Binding id_order}" Width="80"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Cost, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status_delivery.Name}" Width="120"/>
                            <DataGridTextColumn Header="Способ оплаты" Binding="{Binding PayMethod}" Width="150"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Registration_Date, StringFormat=dd.MM.yyyy}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="Итого:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotal" Text="0 руб" FontWeight="Bold" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Финансовые отчёты" FontFamily="Tw Cen MT Condensed Extra Bold">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="31*"/>
                        <ColumnDefinition Width="583*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" Grid.ColumnSpan="2">
                        <TextBlock Text="С:" VerticalAlignment="Center" FontSize="14"/>
                        <DatePicker x:Name="dpStart" Width="100" Margin="5,0,15,0"/>
                        <TextBlock Text="По:" VerticalAlignment="Center" FontSize="14"/>
                        <DatePicker x:Name="dpEnd" Width="100" Margin="5,0,15,0"/>
                        <Button x:Name="btnGenerate" Content="Сформировать" Width="134" Click="BtnGenerate_Click" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <Border  CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ОБОРОТ (все заказы)" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTurnover" FontSize="24" FontWeight="Bold" Text="0 руб"/>
                            </StackPanel>
                        </Border>

                        <Border  CornerRadius="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="ВЫРУЧКА (оплаченные)" FontWeight="Bold"/>
                                <TextBlock x:Name="txtRevenue" FontSize="24" FontWeight="Bold"  Text="0 руб"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <Button Content="Вернуться на главную" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Width="168" Height="30" Click="BtnClose_Click" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
    </Grid>
</Window>
