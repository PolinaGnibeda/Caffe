<Window x:Class="OnlineCaffe.MenuAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineCaffe"
        mc:Ignorable="d"
        Title="MenuAdmin" Height="450" Width="800">
    <Grid>
        <Label Content="Категории:" HorizontalAlignment="Left" Margin="24,25,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Label Content="Добавить категорию:" HorizontalAlignment="Left" Margin="24,61,0,0" VerticalAlignment="Top" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <TextBox x:Name="kategory" HorizontalAlignment="Left" Margin="24,95,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="137" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <ListBox x:Name="listKategory" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,157,582,81" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="24,121,0,0" VerticalAlignment="Top" FontSize="14" Width="137" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_1"/>
        <Button Content="Изменить" HorizontalAlignment="Left" Margin="10,371,0,0" VerticalAlignment="Top" FontSize="14" Width="90" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_3"/>
        <Label Content="Блюда:" HorizontalAlignment="Left" Margin="429,25,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Label Content="Добавить блюдо:" HorizontalAlignment="Left" Margin="399,61,0,0" VerticalAlignment="Top" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <TextBox x:Name="dish" HorizontalAlignment="Left" Margin="399,95,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="400,121,0,0" VerticalAlignment="Top" FontSize="14" Width="120" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_4"/>
        <ListBox x:Name="listDish" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="323,157,102,81" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Изменить" HorizontalAlignment="Left" Margin="368,371,0,0" VerticalAlignment="Top" FontSize="14" Width="87" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_5"/>
        <Button Content="Удалить" HorizontalAlignment="Left" Margin="480,371,0,0" VerticalAlignment="Top" FontSize="14" Width="92" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_6"/>
        <Button Content="Удалить" HorizontalAlignment="Left" Margin="114,371,0,0" VerticalAlignment="Top" FontSize="14" Width="87" FontFamily="Tw Cen MT Condensed Extra Bold" Click="Button_Click_2"/>
        <Button Content="Вернуться на главную" HorizontalAlignment="Left" Margin="618,394,0,0" VerticalAlignment="Top" FontSize="14" Height="30" Width="172" Click="Button_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>

    </Grid>
</Window>
