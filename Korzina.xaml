<Window x:Class="OnlineCaffe.Korzina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineCaffe"
        mc:Ignorable="d"
        Title="Корзина" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Корзина" Grid.Row="0" FontSize="20" FontWeight="Bold" 
               FontFamily="Tw Cen MT Condensed Extra Bold" HorizontalAlignment="Center"/>

        <!-- Список товаров в корзине -->
        <ListBox x:Name="listBasket" Grid.Row="1" Margin="10" 
                 FontFamily="Tw Cen MT Condensed Extra Bold">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DishName}" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Width="40" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:C}}" Width="60" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat={}{0:C}}" Width="70" TextAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Итоговая сумма -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" 
                      FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <TextBlock x:Name="txtTotal" FontSize="16" FontWeight="Bold" 
                      FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10" 
                    HorizontalAlignment="Center">
            <Button Content="Оформить заказ" Width="150" Height="35" Margin="5"
                    Click="BtnCheckout_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Button Content="Очистить корзину" Width="130" Height="35" Margin="5"
                    Click="BtnClear_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Button Content="Перейти на главную" Width="150" Height="35" Margin="5"
                    Click="Button_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>
    </Grid>
</Window>