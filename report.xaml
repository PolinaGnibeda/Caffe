<Window x:Class="OnlineCaffe.report"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет по заказам" Height="500" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Top">
            <Label Content="От:" VerticalAlignment="Center" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <DatePicker x:Name="dpStart" Width="120" Margin="5,0,15,0" VerticalAlignment="Center" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Label Content="До:" VerticalAlignment="Center" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <DatePicker x:Name="dpEnd" Width="120" Margin="5,0,15,0" VerticalAlignment="Center" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Button Content="Сформировать" Width="100" Margin="5,0,15,0" Click="BtnGenerate_Click" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>

        <DataGrid x:Name="listOrders" Grid.Row="1" Margin="10" 
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  FontSize="13" FontFamily="Tw Cen MT Condensed Extra Bold">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа" Binding="{Binding id_order}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Registration_Date, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Cost, StringFormat={}{0:F2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <TextBlock x:Name="txtTotalCount" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <TextBlock x:Name="txtTotalSum" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="Сохранить отчет" Width="152" Click="BtnSave_Click" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Button Content="Вернуться на главную" Width="168" Click="Button_Click" FontSize="14" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>
    </Grid>
</Window>