<Window x:Class="OnlineCaffe.History"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История заказов" Height="450" Width="500">
    <Grid>
        <Label Content="Мои заказы:" HorizontalAlignment="Left" Margin="10,34,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <ListBox x:Name="order" Margin="10,70,24,63" SelectionChanged="order_SelectionChanged" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Перейти на главную" HorizontalAlignment="Left" Margin="10,394,0,0" VerticalAlignment="Top" FontSize="16" Height="30" Click="Button_Click" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Отменить" HorizontalAlignment="Center" Margin="0,394,0,0" VerticalAlignment="Top" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="16" Height="30" Width="96" Click="Button_Click_1"/>
    </Grid>
</Window>
