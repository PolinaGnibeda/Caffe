<Window x:Class="OnlineCaffe.DannClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineCaffe"
        mc:Ignorable="d"
        Title="DannClient" Height="450" Width="500">
    <Grid>
        <Label Content="Данные клиентов" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="24"/>
        <ListBox x:Name="listClient" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="24,51,24,88" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        <Button Content="Вернуться на главную" HorizontalAlignment="Left" Margin="24,376,0,0" VerticalAlignment="Top" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="16" Height="36" Width="236" Click="Button_Click"/>

    </Grid>
</Window>
