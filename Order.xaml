<Window x:Class="OnlineCaffe.Order"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Список заказов -->
        <ListBox x:Name="listOrders" Grid.Row="0" Height="200" 
                 SelectionChanged="listOrders_SelectionChanged" FontFamily="Tw Cen MT Condensed Extra Bold"/>

        <!-- Информация о заказе -->
        <TextBox x:Name="txtOrderInfo" Grid.Row="1" Height="60" 
                 IsReadOnly="True" Margin="0,10,0,10" 
                 VerticalContentAlignment="Center" FontFamily="Tw Cen MT Condensed Extra Bold"/>

        <!-- Способ оплаты -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <Label Content="Способ оплаты:" Width="120" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <ComboBox x:Name="cmbPaymentMethod" Width="200" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnPay" Content="Отметить получение наличных" 
                    Click="Button_Click_1" Width="219" Height="40" Margin="5" FontFamily="Tw Cen MT Condensed Extra Bold"/>
            <Button x:Name="btnBack" Content="Назад" 
                    Click="Button_Click" Width="150" Height="40" Margin="5" FontFamily="Tw Cen MT Condensed Extra Bold"/>
        </StackPanel>
    </Grid>
</Window>