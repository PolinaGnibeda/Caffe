<Window x:Class="OnlineCaffe.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineCaffe"
        mc:Ignorable="d"
        Title="Menu" Height="450" Width="650">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Выберите категорию:" Grid.Row="0" Grid.Column="0" 
               HorizontalAlignment="Left" VerticalAlignment="Top" 
               FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold"/>

        <ComboBox x:Name="kategory" Grid.Row="1" Grid.Column="0" 
                  HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" 
                  FontSize="16" SelectionChanged="ComboBox_SelectionChanged" 
                  FontFamily="Tw Cen MT Condensed Extra Bold"
                  DisplayMemberPath="Name" SelectedValuePath="id_kategory"/>

        <Label Content="Введите название блюда:" 
               HorizontalAlignment="Left" VerticalAlignment="Center" 
               FontSize="16" FontFamily="Tw Cen MT Condensed Extra Bold" Grid.ColumnSpan="2" Margin="273,0,0,0"/>

        <TextBox x:Name="search" Grid.Row="1" 
                 HorizontalAlignment="Left" TextWrapping="Wrap" Text="" 
                 VerticalAlignment="Center" Width="250" FontSize="16" 
                 FontFamily="Tw Cen MT Condensed Extra Bold" Grid.ColumnSpan="2" Margin="273,0,0,0"/>

        <Button Content="Найти" Grid.Row="1" Grid.Column="1" 
                HorizontalAlignment="Left" VerticalAlignment="Center" 
                FontSize="16" Height="30" Width="80" Click="Button_Click" 
                FontFamily="Tw Cen MT Condensed Extra Bold" Margin="213,0,0,0"/>

        <!-- Список блюд -->
        <ListBox x:Name="listDish" Grid.Row="2" Grid.ColumnSpan="2" 
                 Margin="0,10,0,10" FontFamily="Tw Cen MT Condensed Extra Bold">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" 
                            Padding="10,5" Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Картинка -->
                            <Image Grid.Column="0" Width="80" Height="80" 
                                   Source="{Binding ImagePath}" 
                                   Stretch="UniformToFill"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="{Binding Descriptions}" 
                                          FontSize="12" Foreground="Gray"
                                          TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" 
                                       Text="{Binding Price, StringFormat={}{0:C}}" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="Green"
                                       VerticalAlignment="Center"
                                       Margin="10,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Добавить в корзину" Grid.Row="3" Grid.Column="0" 
                HorizontalAlignment="Left" Width="140" Height="35" Margin="0,5"
                FontSize="14" Click="Button_Click_3" 
                FontFamily="Tw Cen MT Condensed Extra Bold"/>

        <Button Content="Корзина" Grid.Row="3" Grid.Column="0" 
                HorizontalAlignment="Left" Width="100" Height="35" Margin="158,5,0,5"
                FontSize="14" Click="Button_Click_1" 
                FontFamily="Tw Cen MT Condensed Extra Bold"/>

        <Button Content="Вернуться на главную" Grid.Row="3" Grid.Column="1" 
                HorizontalAlignment="Right" Width="150" Height="35" Margin="0,5"
                FontSize="14" Click="Button_Click_2" 
                FontFamily="Tw Cen MT Condensed Extra Bold"/>
    </Grid>
</Window>