<Window x:Class="OnlineCaffe.Regestrazia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20,28,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание учётной записи" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>


        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="lastName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="name" Grid.Row="1" Grid.Column="1" Margin="5,5,0,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="middleName" Grid.Row="2" Grid.Column="1" Margin="5,5,0,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Email" VerticalAlignment="Center" Margin="10,5,0,5"/>
            <TextBox x:Name="email" Grid.Row="0" Grid.Column="4" Margin="5,5,10,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="3" Text="Телефон" VerticalAlignment="Center" Margin="10,5,0,5"/>
            <TextBox x:Name="phone" Grid.Row="1" Grid.Column="4" Margin="5,5,10,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="3" Text="Логин" VerticalAlignment="Center" Margin="10,5,0,5"/>
            <TextBox x:Name="login" Grid.Row="2" Grid.Column="4" Margin="5,5,10,5" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="Пароль" VerticalAlignment="Center" Margin="10,5,0,5"/>
            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" Margin="5,5,10,5">
                <TextBox x:Name="password" Width="110" Height="30" VerticalContentAlignment="Center"/>
                <Button x:Name="showPasswordBtn" Content="👁" Width="30" Height="30" Margin="5,0,0,0" 
                        ToolTip="Показать пароль" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Зарегистрироваться" HorizontalAlignment="Center" 
                Width="200" Height="40" FontSize="14" FontWeight="Bold"
                Click="Button_Click"  
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- Сообщение -->
        <TextBlock x:Name="messageText" Grid.Row="3" Text="" Foreground="Red" 
                   HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>
